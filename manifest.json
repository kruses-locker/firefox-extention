{
  "manifest_version": 3,
  "name": "Velvet & Rose New Tab",
  "version": "1.7.0",
  "description": "A minimalist, customizable new tab page with a Rainmeter-style clock, multi-engine search switcher, live YouTube Music mini-player, and TMDB movie watchlist.",
  "permissions": [
    "storage",
    "topSites",
    "history",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://open.spotify.com/*",
    "https://api.themoviedb.org/*",
    "https://image.tmdb.org/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://www.youtube.com/*",
        "https://open.spotify.com/*"
      ],
      "js": ["ytm-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data: https:; connect-src 'self' https://api.themoviedb.org;"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "velvet-rose-newtab-v2@kruses.local",
      "strict_min_version": "109.0"
    }
  }
}
