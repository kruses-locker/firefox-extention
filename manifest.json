{
  "manifest_version": 3,
  "name": "Velvet New Tab",
  "version": "1.6.0",
  "description": "Minimalist custom New Tab with Rainmeter-style clock, DuckDuckGo bangs, YTM live player, and watchlist.",
  "icons": {
    "48": "assets/icon.svg",
    "96": "assets/icon.svg"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "topSites",
    "history",
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://music.youtube.com/*",
    "*://*.youtube.com/*",
    "*://*.spotify.com/*",
    "https://itunes.apple.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*",
        "*://*.youtube.com/*",
        "*://*.spotify.com/*"
      ],
      "js": [
        "ytm-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "velvet-rose-newtab-v2@kruses.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}